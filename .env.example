NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Optional: only if you bring your own DB/PostgREST (Supabase is default)
DATABASE_URL=postgresql://

# Rate limit (Redis / Upstash) — khi set đủ 2 biến, rate-limit dùng Redis atomic
# (share mọi Edge isolate). Khi để trống, fallback in-memory (mềm, per-instance).
UPSTASH_REDIS_REST_URL=https://<project>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-rest-token>
