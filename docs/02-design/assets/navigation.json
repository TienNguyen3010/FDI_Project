      "items": [
        {
          "label": "Customers",
          "icon": "users",
          "route": "/customers",
          "permission": "customer.read"
        },
        {
          "label": "Projects",
          "icon": "folder",
          "route": "/projects",
          "permission": "project.read"
        },
        {
          "label": "Sites",
          "icon": "map-pin",
          "route": "/sites",
          "permission": "site.read"
        },
        {
          "label": "Infrastructure",
          "icon": "network",
          "route": "/infrastructure",
          "permission": "diagram.read"
        },
        {
          "label": "Assets",
          "icon": "server",
          "route": "/assets",
          "permission": "asset.read"
        }
      ]
    },
    {
      "label": "VẬN HÀNH & DỊCH VỤ",
      "items": [
        {
          "label": "Works",
          "icon": "list-checks",
          "route": "/my-work",
          "permission": "task.read"
        },
        {
          "label": "Service Desk",
          "icon": "ticket",
          "route": "/tickets",
          "permission": "ticket.read"
        },
        {
          "label": "Maintenance",
          "icon": "wrench",
          "route": "/maintenance",
          "permission": "maintenance.read"
        },
        {
          "label": "Monitoring",
          "icon": "activity",
          "route": "/monitoring",
          "permission": "monitoring.read"
        }
      ]
    },
    {
      "label": "TÀI LIỆU & BÁO CÁO",
      "items": [
        {
          "label": "Documents",
          "icon": "file-text",
          "route": "/documents",
          "permission": "document.read"
        },
        {
          "label": "Reports",
          "icon": "chart-column",
          "route": "/reports",
          "permission": "report.read"
        }
      ]
    },
    {
      "label": "HỆ THỐNG",
      "items": [
        {
          "label": "Admin",
          "icon": "settings",
          "route": "/admin",
