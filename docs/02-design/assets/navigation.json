        {
          "label": "Vai trò truy cập",
          "icon": "shield-check",
          "route": "/admin/roles",
          "permission": "admin.role_manage",
          "parent": "Quản trị"
        },
        {
          "label": "Bộ Quyền Mẫu",
          "icon": "file-text",
          "route": "/admin/permission-templates",
          "permission": "admin.role_manage",
          "parent": "Quản trị"
        },
        {
          "label": "Nhật ký quyền",
          "icon": "clipboard-list",
          "route": "/admin/permission-audit",
          "permission": "admin.audit_read",
          "parent": "Quản trị"
        }
      ]
    }
  ],
  "rules": [
    "Section order and all menu labels must match approved screenshot",
    "Do not expose monitoring if monitoring.read permission is not configured; feature flag until authorized",
    "Active Dashboard pale green, dark green text and 3px green left rail",
    "Notification badge is scoped actionable count, not a global count",
    "Collapsed sidebar 72px with accessible tooltips and keyboard navigation",
    "Do not rely on hidden navigation for security",
    "User profile anchored at bottom"
  ]
